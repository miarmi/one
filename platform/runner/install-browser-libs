#!/bin/bash
# Install the system libraries Playwright's browsers need (as root, once at
# setup; run it again after Playwright's version in the pipeline changes):
#   install-browser-libs 1.56.0
# Uses its own Node 22 from nodejs.org, checked against nodejs.org's list of
# SHA-256 sums, because Ubuntu's Node is too old for current Playwright.
set -euo pipefail

version="${1:?usage: install-browser-libs <playwright version>}"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "not a version: $version" >&2
  exit 2
fi
dir=/opt/lab-runner-node
base=https://nodejs.org/dist/latest-v22.x
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -fsS -m 60 -o "$tmp/SHASUMS256.txt" "$base/SHASUMS256.txt"
line="$(grep -E ' node-v22\.[0-9]+\.[0-9]+-linux-x64\.tar\.xz$' "$tmp/SHASUMS256.txt")"
file="${line##* }"
curl -fsS -m 300 -o "$tmp/$file" "$base/$file"
(cd "$tmp" && sha256sum -c --status <<<"$line")
rm -rf "$dir"
mkdir -p "$dir"
tar -xJf "$tmp/$file" -C "$dir" --strip-components=1
PATH="$dir/bin:$PATH" npx --yes "playwright@$version" install-deps chromium firefox webkit
echo "browser libraries for Playwright $version installed"
